<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN" name="sc-sys-wms-api">
  <Appenders>
    <Console name="Console" target="SYSTEM_OUT">
      <PatternLayout>
        <Pattern>%d{ISO8601} [%t] %-5level %logger{36} correlation=%X{correlationId} - %msg%n</Pattern>
      </PatternLayout>
    </Console>
  </Appenders>
  <Loggers>
    <AsyncRoot level="INFO">
      <AppenderRef ref="Console"/>
    </AsyncRoot>
  </Loggers>
</Configuration>
